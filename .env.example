# Telegram bot token from BotFather
TELEGRAM_BOT_TOKEN=

# Your personal Telegram user ID.
# Only this user can access the bot.
ADMIN_TELEGRAM_ID=

# Gemini API key
GEMINI_API_KEY=

# Gemini model name.
# The free tier limits requests per minute (RPM) and per day (RPD), separately
# for each model. One writer session uses roughly 8-12 requests, so the small
# models run out almost immediately. Check your own numbers at ai.dev/rate-limit.
#
# Free tier limits seen in practice:
#   gemini-3.5-flash-lite   15 RPM, 500 RPD   <- use this one
#   gemini-2.5-flash         5 RPM,  20 RPD
#   gemini-3.8-flash         5 RPM,  20 RPD
#
# Name the model exactly. The "-latest" aliases can resolve to a low-limit model.
LLM_MODEL=gemini-3.5-flash-lite

# IANA timezone used for dates and times, for example Asia/Amman
TIMEZONE=UTC

# SQLite database file for conversation history and memory
DB_PATH=praxis.db

# development | production
ENV=development
