# Telegram bot token from BotFather
TELEGRAM_BOT_TOKEN=

# Your personal Telegram user ID.
# Only this user can access the bot.
ADMIN_TELEGRAM_ID=

# Gemini API key
GEMINI_API_KEY=

# Gemini model name
LLM_MODEL=gemini-2.5-flash

# IANA timezone used for dates and times, for example Asia/Amman
TIMEZONE=UTC

# development | production
ENV=development
